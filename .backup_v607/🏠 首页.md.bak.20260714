## 🔍 知识库体检

**近期活跃知识笔记**

```dataviewjs
try {
    let notes = dv.pages('"10_Projects" or "30_Resources"')
        .where(p => (p.status == "active" || p.status == "mature")
            && !p.file.path.includes("Bullet Journal")
            && !p.file.path.includes("Habit Tracking")
            && !p.file.path.includes("模板")
            && !p.file.path.includes("MOC"))
        .sort(p => p.file.mtime, "desc").limit(10);
    if (notes.length === 0) {
        dv.span("🛌 近期无活跃笔记。");
    } else {
        dv.table(["笔记", "最后修改"],
            notes.map(p => [p.file.link, p.file.mtime.toFormat("MM-dd")])
        );
    }
} catch(e) {
    dv.span("⚠️ 活跃笔记加载失败");
}
```

**⚠️ 积压预警**

```dataviewjs
try {
    let processDir = dv.pages('"00_Inbox/processing"');
    let cutoff = dv.date("now").minus({days: 7});
    let backlog = processDir.where(p => dv.date(p.file.ctime) <= cutoff);
    if (backlog.length === 0) {
        dv.span("✅ 加工区无积压，收件箱健康！");
    } else {
        dv.table(["积压素材", "入站日期", "已积压天数"],
            backlog.sort(p => p.file.ctime).limit(10).map(p => [
                p.file.link,
                dv.date(p.file.ctime).toFormat("MM-dd"),
                dv.date("now").diff(dv.date(p.file.ctime), "days").toFixed(0)
            ])
        );
    }
} catch(e) {
    dv.span("⚠️ 积压预警加载失败");
}
```

## 🔥 注意力热力图

```dataviewjs
try {
    const pages = dv.pages('"00_Inbox" or "10_Projects" or "20_Areas" or "30_Resources" or "日记"')
        .where(p => p.file.day);
    
    const entries = pages.map(p => ({
        date: p.file.day.toFormat("yyyy-MM-dd"),
        intensity: 1
    }));
    
    const calendarData = {
        colors: "githubGreen",
        entries: entries
    };
    
    renderHeatmapCalendar(this.container, calendarData);
    
} catch(e) {
    if(e.message && e.message.includes("renderHeatmapCalendar")){
        dv.span("⚠️ 热力图加载失败：请确认 Heatmap Calendar 插件已开启");
    } else {
        dv.span("⚠️ 暂无带日期标记的笔记，无法生成热力图");
    }
}
```

