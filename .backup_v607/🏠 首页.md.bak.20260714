### 🚀 活跃项目

```dataviewjs
try {
    let projects = dv.pages('"10_Projects"').where(p => p.status == "active").sort(p => p.file.mtime, "desc").limit(6);
    if (projects.length === 0) {
        dv.span("🛌 暂无活跃项目，享受片刻宁静。");
    } else {
        dv.table(["项目", "最近更新"],
            projects.map(p => [p.file.link, p.file.mtime.toFormat("MM-dd")])
        );
    }
} catch(e) {
    dv.span("⚠️ 活跃项目加载失败");
}
```

---

### 📥 最新素材

```dataviewjs
try {
    let materials = dv.pages('"00_Inbox/_raw" or "00_Inbox/processing"')
        .where(p => !p.file.path.includes("模板") && !p.file.path.includes("MOC"))
        .sort(p => p.file.mtime, "desc").limit(8);
    if (materials.length === 0) {
        dv.span("📭 暂无最新素材入站。");
    } else {
        dv.table(["素材", "入站时间"],
            materials.map(p => [p.file.link, p.file.mtime.toFormat("MM-dd HH:mm")])
        );
    }
} catch(e) {
    dv.span("⚠️ 最新素材加载失败");
}
```

