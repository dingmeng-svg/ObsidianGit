## 🔥 注意力热力图

```dataviewjs
try {
    const pages = dv.pages('"00_Inbox" or "10_Projects" or "20_Areas" or "30_Resources" or "日记"')
        .where(p => p.file.day);
    const entries = pages.map(p => ({
        date: p.file.day.toFormat("yyyy-MM-dd"),
        intensity: 1
    }));
    renderHeatmapCalendar(this.container, {
        colors: "githubGreen",
        entries: entries
    });
} catch(e) {
    dv.span("⚠️ 热力图加载失败，请确认 Heatmap Calendar 插件已启用");
}
```

