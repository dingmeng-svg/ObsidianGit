/* =========================================
   v6.0.7 Clean Slate
   全量纯净版 · 修复 CSS 崩塌与双链解析
   ========================================= */

.homepage {
  --color-green: #4a7c59;
  --color-green-light: #e8f5e9;
  --color-green-bg: #f1f8e9;
  --color-border: #e0e0e0;
  --color-text: #2d3a2d;
  --color-text-muted: #6b7d6b;
  --radius-card: 12px;
  --radius-capsule: 20px;
  --shadow-card: 0 2px 8px rgba(0, 0, 0, 0.04);
  --shadow-hover: 0 4px 16px rgba(0, 0, 0, 0.08);
  --spacing-module: 1.5rem;
}

.homepage .frontmatter-container,
.homepage .metadata-container {
  display: none !important;
}

.homepage .callout[data-callout="info"] {
  background: linear-gradient(135deg, var(--color-green-light), var(--color-green-bg));
  border: 1px solid #c8e6c9;
  border-radius: 16px;
  padding: 1.5rem 2rem;
  margin-bottom: var(--spacing-module);
}

.homepage .callout[data-callout="info"] .callout-title {
  font-size: 1.3rem;
  font-weight: 700;
  color: var(--color-text);
}

.homepage .callout[data-callout="info"] ~ p {
  margin: 0.5rem 0 var(--spacing-module) 0;
  line-height: 2.2;
}

.homepage .callout[data-callout="info"] ~ p a.internal-link {
  display: inline-block;
  padding: 0.4rem 1rem;
  margin: 0.1rem 0.2rem;
  border-radius: var(--radius-capsule);
  background: #fff;
  border: 1px solid var(--color-border);
  color: var(--color-text) !important;
  font-weight: 600;
  font-size: 0.85rem;
  text-decoration: none !important;
  transition: all 0.2s ease;
}

.homepage .callout[data-callout="info"] ~ p a.internal-link:hover {
  border-color: var(--color-green);
  background: var(--color-green-bg);
  transform: translateY(-1px);
}

.homepage h2 ~ ul {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 0.75rem;
  width: 100%;
  margin: 0.5rem 0 var(--spacing-module) 0;
  padding: 0;
  list-style: none !important;
}

.homepage h2 ~ ul li {
  background: #fff;
  border-radius: var(--radius-card);
  border: 1px solid var(--color-border);
  padding: 0.8rem 0.5rem;
  min-height: 90px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 0.2rem;
  box-shadow: var(--shadow-card);
  transition: transform 0.2s;
}

.homepage h2 ~ ul li:hover {
  transform: translateY(-2px);
  box-shadow: var(--shadow-hover);
}

.homepage h2 ~ ul li strong {
  display: block;
  font-size: 0.95rem;
  color: var(--color-text);
}

.homepage h2 ~ ul li a.internal-link {
  text-decoration: none !important;
  font-weight: 600;
  font-size: 0.85rem;
  padding: 0.2rem 0.8rem;
  border-radius: 4px;
  background: rgba(0, 0, 0, 0.03);
}

.homepage h2 ~ ul li:nth-child(1) { border-left: 4px solid #9e9e9e; }
.homepage h2 ~ ul li:nth-child(1) a { color: #616161; }
.homepage h2 ~ ul li:nth-child(2) { border-left: 4px solid #4caf50; }
.homepage h2 ~ ul li:nth-child(2) a { color: #2e7d32; }
.homepage h2 ~ ul li:nth-child(3) { border-left: 4px solid #2196f3; }
.homepage h2 ~ ul li:nth-child(3) a { color: #1565c0; }
.homepage h2 ~ ul li:nth-child(4) { border-left: 4px solid #bdbdbd; }
.homepage h2 ~ ul li:nth-child(4) a { color: #757575; }

.homepage .dataview.table-view-table {
  width: 100%;
  border-collapse: collapse;
  margin-top: 0.5rem;
}

.homepage .dataview.table-view-table th {
  text-align: left;
  padding: 0.5rem;
  background: #f5f5f5;
  border-bottom: 2px solid #ddd;
}

.homepage .dataview.table-view-table td {
  padding: 0.5rem;
  border-bottom: 1px solid #eee;
}

.theme-dark .homepage .callout[data-callout="info"] ~ p a.internal-link {
  background: #242e24;
  border-color: #3a4a3a;
  color: #e1efe1 !important;
}

.theme-dark .homepage h2 ~ ul li {
  background: #1a221a;
  border-color: #333;
}

.theme-dark .homepage h2 ~ ul li strong {
  color: #cde2cd;
}

.theme-dark .homepage h2 ~ ul li a.internal-link {
  color: #81c784 !important;
}

@media screen and (max-width: 700px) {
  .homepage h2 ~ ul { grid-template-columns: repeat(2, 1fr); }
}

@media screen and (max-width: 480px) {
  .homepage h2 ~ ul { grid-template-columns: 1fr; gap: 0.5rem; }
  .homepage { padding: 0 0.5rem; }
}