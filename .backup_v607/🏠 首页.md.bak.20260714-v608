## 🔥 近期活跃度

```dataviewjs
try {
    const now = dv.date("now");
    const start = now.minus({days: 30});
    const count = dv.pages().where(p => p.file.mtime >= start && !p.file.path.startsWith("90_System")).length;
    const html = `<div style="text-align:center; padding:1rem; background:var(--color-green-bg); border-radius:12px; color:var(--color-green);">
        <h2 style="margin:0; font-size:2rem;">${count}</h2>
        <span style="font-size:0.8rem; color:#666;">过去 30 天活跃笔记</span>
    </div>`;
    dv.span(html);
} catch(e) {
    dv.span("⚠️ 活跃度统计加载失败");
}
```

