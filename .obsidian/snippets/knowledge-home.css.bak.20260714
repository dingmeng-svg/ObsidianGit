/* ========== Hermes 首页 v5.2 永久固化终版 ========== */

/* --- 彻底隐藏 YAML 属性表（全版本兼容） --- */
.homepage .frontmatter-container,
.homepage .metadata-container,
.homepage .metadata-properties-heading,
.homepage .frontmatter { display: none !important; }

/* --- 顶部代码块边距消隐 --- */
.homepage .block-language-dataviewjs:first-of-type { margin-top: 0; margin-bottom: 0; }

/* --- 顶部横幅 --- */
.homepage .home-header {
  display: flex; justify-content: space-between; align-items: flex-start;
  background: linear-gradient(135deg, #e8f5e9 0%, #f1f8e9 100%);
  border: 1px solid #c8e6c9; border-radius: 16px;
  padding: 1.5rem 2rem; margin-bottom: 1.5rem; gap: 1rem; flex-wrap: wrap;
  box-shadow: 0 4px 20px rgba(46,125,50,0.08);
}
.homepage .home-header-left { flex: 1; min-width: 260px; }
.homepage .home-header-title { font-size: 0.85rem; font-weight: 600; color: #4a7c59; text-transform: uppercase; letter-spacing: 0.15em; margin-bottom: 0.5rem; opacity: 0.8; }
.homepage .home-header-subtitle { font-size: 1.2rem; font-weight: 700; color: #2d3a2d; }
.homepage .home-header-right { text-align: right; min-width: 200px; }
.homepage .home-header-date { font-size: 1.1rem; font-weight: 600; color: #2d3a2d; margin-bottom: 0.5rem; }
.homepage .home-header-stats { display: flex; flex-direction: column; gap: 0.25rem; font-size: 0.85rem; color: #6b7d6b; }

/* --- 今日行动链接 --- */
.homepage .action-links {
  display: flex; flex-wrap: wrap; gap: 0.75rem; margin: 0.5rem 0 1.5rem;
}
.homepage .action-links a {
  display: inline-block; padding: 0.6rem 1.2rem; border-radius: 10px;
  background: #fff; border-left: 4px solid #ccc; text-decoration: none !important;
  font-weight: 600; font-size: 0.9rem;
  box-shadow: 0 2px 6px rgba(0,0,0,0.03); transition: transform 0.2s, box-shadow 0.2s;
}
.homepage .action-links a:hover { transform: translateY(-2px); box-shadow: 0 4px 10px rgba(0,0,0,0.08); }
.homepage .action-links a:nth-child(1) { border-left-color: #9e9e9e; color: #616161; }
.homepage .action-links a:nth-child(2) { border-left-color: #4caf50; color: #2e7d32; }
.homepage .action-links a:nth-child(3) { border-left-color: #2196f3; color: #1565c0; }
.homepage .action-links a:nth-child(4) { border-left-color: #bdbdbd; color: #757575; }

/* --- 双链全局清除下划线 --- */
.homepage a.internal-link { text-decoration: none !important; border-bottom: none !important; }

/* --- 快速导航胶囊 --- */
.homepage p:has(a.internal-link) { display: flex; flex-wrap: wrap; gap: 0.5rem; }
.homepage p a.internal-link {
  display: inline-block; padding: 0.4rem 0.8rem; border-radius: 8px; background: #fff;
  border: 1px solid #e0e0e0; color: #2d3a2d !important; font-weight: 600; font-size: 0.9rem;
  margin: 0 !important;
}
.homepage p a.internal-link:hover { border-color: #4a7c59; background: #f1f8e9; }

/* --- 折叠 Callout --- */
.homepage .callout[data-callout="example"] { border: 1px solid #e0e0e0; border-radius: 12px; padding: 0.75rem 1rem; margin-top: 1.5rem; background: #fff; }
.homepage .callout[data-callout="example"] .callout-title { font-size: 1rem; font-weight: 700; color: #2d3a2d; }
.homepage .callout[data-callout="example"] .callout-content { padding-top: 0.5rem; }

/* --- 空状态 --- */
.homepage .empty-state {
  text-align: center; padding: 1rem; background: #fafcfa;
  border: 1px dashed #c8e6c9; border-radius: 12px; color: #8b9a8b; margin: 0.5rem 0;
}
.homepage .empty-state.empty-success { background: #f1f8e9; border-color: #a5d6a7; color: #2e7d32; }
.homepage .empty-state.empty-error { background: #fff3f3; border-color: #ef9a9a; color: #c62828; }

/* --- 页脚 --- */
.homepage .home-footer { margin-top: 2rem; padding-top: 1rem; border-top: 1px solid #e0e0e0; text-align: center; font-size: 0.75rem; color: #9e9e9e; }

/* --- Dataview 表格 --- */
.homepage .dataview.table-view-table { font-size: 0.9rem; }
.homepage .dataview.table-view-table a { font-size: 0.9rem; }
.homepage .dataview.table-empty, .homepage .dataview.result-empty { display: none; }

/* --- 响应式 --- */
@media (max-width: 900px) {
  .homepage .home-header { flex-direction: column; }
  .homepage .home-header-right { text-align: left; }
}
@media (max-width: 700px) {
  .homepage .home-header { padding: 1rem; }
  .homepage .home-header-subtitle { font-size: 1rem; }
  .homepage .action-links { flex-direction: column; }
}