##### 🗺️ 本月行动 · 行

```dataviewjs
const now = dv.date("now");
const monthStart = now.startOf("month");
const bujoTotal = dv.pages('"20_Areas/22_个人成长/Bullet Journal/Daily"').length;
const dailyThisMonth = dv.pages('"20_Areas/22_个人成长/Bullet Journal/Daily"')
  .where(p => p.file.day && p.file.day >= monthStart).length;
const reviews = dv.pages('"20_Areas/22_个人成长/Bullet Journal/Weekly"').length + dv.pages('"20_Areas/22_个人成长/Bullet Journal/Monthly"').length;

dv.span(`
  <div class="stat-block-wrapper">
    <div class="stat-grid">
      <div class="stat-item"><span class="num">${bujoTotal}</span><span class="label">BuJo</span></div>
      <div class="stat-item"><span class="num">${dailyThisMonth}</span><span class="label">日记</span></div>
      <div class="stat-item"><span class="num">${reviews}</span><span class="label">复盘</span></div>
      <div class="stat-item"><span class="num">4</span><span class="label">项目</span></div>
    </div>
  </div>
`);
```


