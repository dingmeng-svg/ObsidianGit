##### 📡 资产总览 · 知

```dataviewjs
const all = dv.pages('"30_Resources/31_Atomic_Notes"')
  .where(p => p.status && p.status != "deprecated" && p.status != "archived");
const total = all.length;
const mocs = dv.pages('"30_Resources/32_MOCs"').length;
const recipe = dv.pages('"20_Areas/23_生活与健康/食物"').length;
const fitness = dv.pages('"20_Areas/23_生活与健康/运动"').length;
const lang = dv.pages('"30_Resources/31_Atomic_Notes/语言"').length;

dv.span(`
  <div class="stat-block-wrapper">
    <div class="stat-grid">
      <div class="stat-item"><span class="num">${total}</span><span class="label">原子笔记</span></div>
      <div class="stat-item"><span class="num">${mocs}</span><span class="label">MOC</span></div>
      <div class="stat-item"><span class="num">${recipe}</span><span class="label">食谱</span></div>
      <div class="stat-item"><span class="num">${fitness + lang}</span><span class="label">健康语言</span></div>
    </div>
  </div>
`);
```


