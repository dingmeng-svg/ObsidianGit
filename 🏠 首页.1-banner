> ## 知是行之始，行是知之成。
> 
> > 循环不息，化育乃生。
> 
> ```dataviewjs
> const now = dv.luxon.DateTime.now();
> const todayStr = now.toFormat("yyyy-MM-dd");
> const monthStart = now.startOf("month");
> const daysPassed = Math.floor(now.diff(monthStart, "days").days) + 1;
> 
> const collectorFile = dv.page("00_Inbox/Collector");
> const collectorTasks = collectorFile ? collectorFile.file.tasks : [];
> const collectorTotal = collectorTasks.length;
> const collectorDone = collectorTasks.where(t => t.completed).length;
> 
> const todayDiary = dv.pages('"20_Areas/22_个人成长/Bullet Journal/Daily"')
>     .where(p => p.file.day && p.file.day.toFormat("yyyy-MM-dd") === todayStr)
>     .first();
> 
> let mitStr = "0/0", habitStr = "0/0";
> if (todayDiary) {
>     const tasks = todayDiary.file.tasks;
>     const total = tasks.length;
>     const done = tasks.where(t => t.completed).length;
>     mitStr = `${done}/${total}`;
>     const habitTasks = tasks.where(t => t.text.includes("[habit::"));
>     habitStr = `${habitTasks.where(t => t.completed).length}/${habitTasks.length}`;
> }
> 
> const monthDiaries = dv.pages('"20_Areas/22_个人成长/Bullet Journal/Daily"')
>     .where(p => p.file.name.match(/^\d{4}-\d{2}-\d{2}$/) && p.file.day && p.file.day.ts >= monthStart.ts).length;
> const rawTotal = dv.pages('"00_Inbox/_raw"').where(p => p.file.name != "_raw MOC").length;
> const rawPending = dv.pages('"00_Inbox/_raw"').where(p => p.file.name != "_raw MOC" && p.ingest_status != "ingested").length;
> const extTotal = dv.pages('"00_Inbox/外部导入"').where(p => p.file.name != "_说明").length;
> const extPending = dv.pages('"00_Inbox/外部导入"').where(p => p.file.name != "_说明" && p.status != "archived").length;
> const inboxTotal = rawTotal + extTotal;
> const inboxPending = rawPending + extPending;
> 
> dv.span(`<span class="homepage-stats-banner">📬 Nexus ${collectorDone}/${collectorTotal} ｜ 🎯 Tasks ${mitStr} ｜ ✅ Habits ${habitStr} ｜ 📝 Daily Log ${monthDiaries}/${daysPassed} days ｜ 📥 Inbox ${inboxPending}/${inboxTotal}</span>`);
> ```
> 
